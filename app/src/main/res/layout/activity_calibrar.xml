<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0F"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎯 CALIBRAR COORDENADAS"
        android:textColor="#FFD700"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <!-- Instrucción actual -->
    <TextView
        android:id="@+id/tvInstruccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A2E"
        android:padding="12dp"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:layout_marginBottom="12dp"/>

    <!-- Preview de imagen táctil -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#111122"
        android:layout_marginBottom="12dp">

        <ImageView
            android:id="@+id/imgPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/placeholder_calibrar"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Carga un screenshot\ny toca el botón"
            android:textColor="#444466"
            android:textSize="16sp"
            android:gravity="center"
            android:id="@+id/tvPlaceholder"/>
    </FrameLayout>

    <!-- Botones -->
    <Button
        android:id="@+id/btnSelImg"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="📂 Cargar screenshot"
        android:backgroundTint="#1565C0"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSaltar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Cancelar"
            android:backgroundTint="#333333"
            android:textColor="#AAAAAA"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnSiguiente"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="2"
            android:text="Siguiente →"
            android:backgroundTint="#FFD700"
            android:textColor="#000000"
            android:textStyle="bold"
            android:enabled="false"
            android:alpha="0.4"/>
    </LinearLayout>

</LinearLayout>
